<dialog class="modal" id="pin-dialog" aria-labelledby="pin-title">
  <div class="modal-card pin-card">
    <div class="modal-heading">
      <div><p class="eyebrow">Studio settings</p><h2 id="pin-title">Admin access</h2></div>
      <button class="icon-button" type="button" data-close="pin-dialog" aria-label="Close">×</button>
    </div>
    <p class="muted-copy">Enter your local admin PIN to change brand and kiosk settings.</p>
    <label class="sr-only" for="pin-input">Admin PIN</label>
    <input id="pin-input" class="text-input pin-input" type="password" inputmode="numeric" maxlength="16" autocomplete="off" />
    <p class="error-copy is-hidden" id="pin-error" role="alert">That PIN did not match. Try again.</p>
    <div class="keypad">
      {Array.from({ length: 9 }, (_, i) => <button type="button" data-key={i + 1}>{i + 1}</button>)}
      <button type="button" id="pin-clear">Clear</button><button type="button" data-key="0">0</button><button type="button" id="pin-submit">Unlock</button>
    </div>
    <p class="fine-print">This PIN is a convenience lock only; it is not server-side authentication.</p>
  </div>
</dialog>

<dialog class="modal" id="admin-dialog" aria-labelledby="admin-title">
  <div class="modal-card admin-card">
    <div class="modal-heading">
      <div><p class="eyebrow">Local configuration</p><h2 id="admin-title">Brand &amp; kiosk setup</h2></div>
      <button class="button button-primary" type="button" id="apply-settings">Apply settings</button>
    </div>
    <div class="admin-content">
      <section class="settings-card">
        <div class="settings-intro"><h3>Experience</h3><p>Choose whether visitors can adjust technical and brand controls.</p></div>
        <label class="settings-toggle"><span><strong>Lock to brand palette</strong><small>Map all image tones to the active brand colors.</small></span><input id="setting-lock-palette" type="checkbox" checked /></label>
        <label class="settings-toggle"><span><strong>Fair / kiosk mode</strong><small>Save a PIN-locked kiosk. To leave, unlock admin settings and disable this option. Browser fullscreen itself can still be exited.</small></span><input id="setting-fair-mode" type="checkbox" /></label>
        <label class="field-label">Camera
          <select id="setting-camera" class="text-input"><option value="">Automatic / front camera</option></select>
        </label>
        <p class="fine-print" id="camera-device-help">Start a camera once to reveal device names. Selection applies to live and still capture.</p>
      </section>

      <section class="settings-card">
        <div class="settings-intro"><h3>Brand identity</h3><p>All settings are saved in this browser only.</p></div>
        <label class="field-label">Application title<input id="setting-title" class="text-input" type="text" maxlength="48" /></label>
        <label class="field-label">Brand signature<input id="setting-signature" class="text-input" type="text" maxlength="32" /></label>
        <label class="field-label">Default message<textarea id="setting-message" class="text-input" rows="2" maxlength="160"></textarea></label>
        <label class="field-label">Message starting position
          <select id="setting-message-position" class="text-input">
            <option value="upper">Top center</option><option value="topleft">Top left</option><option value="topright">Top right</option>
            <option value="middleleft">Center left</option><option value="center">Center</option><option value="middleright">Center right</option>
            <option value="bottomleft">Bottom left</option><option value="lower">Bottom center</option><option value="bottomright">Bottom right</option>
          </select>
        </label>
        <label class="settings-toggle"><span><strong>Lock message position</strong><small>In fair mode, visitors cannot drag or reposition the message.</small></span><input id="setting-lock-message-position" type="checkbox" checked /></label>

        <div class="brand-asset-block">
          <div class="settings-intro"><h3>Logo</h3><p>Upload an SVG, PNG, JPEG, or WebP logo. It is stored only on this device.</p></div>
          <div class="brand-asset-row">
            <img id="setting-logo-preview" class="brand-asset-preview is-hidden" alt="Current brand logo preview" />
            <label class="button button-small button-quiet" for="setting-logo-file">Upload logo</label>
            <input id="setting-logo-file" type="file" accept=".svg,image/png,image/jpeg,image/webp" hidden />
            <button class="button button-small button-danger" id="remove-logo" type="button">Remove</button>
          </div>
          <label class="field-label">Logo starting position
            <select id="setting-logo-position" class="text-input">
              <option value="upper">Top center</option><option value="topleft">Top left</option><option value="topright">Top right</option>
              <option value="middleleft">Center left</option><option value="center">Center</option><option value="middleright">Center right</option>
              <option value="bottomleft">Bottom left</option><option value="lower">Bottom center</option><option value="bottomright">Bottom right</option>
            </select>
          </label>
          <label class="settings-toggle"><span><strong>Lock logo position</strong><small>In fair mode, visitors cannot drag or reposition the logo.</small></span><input id="setting-lock-logo-position" type="checkbox" checked /></label>
        </div>

        <div class="brand-asset-block">
          <div class="settings-intro"><h3>Typography</h3><p>Upload a font file to use it in the artwork. Use only fonts licensed for embedding.</p></div>
          <div class="brand-asset-row">
            <span id="setting-font-name" class="muted-copy">System font</span>
            <label class="button button-small button-quiet" for="setting-font-file">Upload font</label>
            <input id="setting-font-file" type="file" accept=".woff2,.woff,.ttf,.otf,font/woff2,font/woff,font/ttf,font/otf" hidden />
            <button class="button button-small button-danger" id="remove-font" type="button">Remove</button>
          </div>
          <label class="field-label">Artwork font
            <select id="setting-font-choice" class="text-input"><option value="system">System sans-serif</option><option value="uploaded">Uploaded font</option></select>
          </label>
        </div>

        <label class="field-label">Brand palette<select id="setting-theme" class="text-input"></select></label>
        <div class="theme-editor-heading"><strong>Palette colors</strong><button class="text-button" id="add-color" type="button">＋ Add color</button></div>
        <div class="theme-colors" id="theme-colors"></div>
        <div class="button-row">
          <button class="button button-small button-quiet" id="new-theme" type="button">New palette</button>
          <button class="button button-small button-danger" id="delete-theme" type="button">Delete palette</button>
        </div>
      </section>

      <section class="settings-card">
        <div class="settings-intro"><h3>Pixel rules</h3><p>Cutouts apply to heuristic subjects. Recognized subjects retain highlights and shadows for clarity. Tile gaps are optional.</p></div>
        <label class="range-control">
          <span><span>Dark cutout threshold</span><output id="dark-cutoff-value">20%</output></span>
          <input id="setting-dark-cutoff" type="range" min="0" max="60" value="20" />
        </label>
        <label class="range-control">
          <span><span>Bright cutout threshold</span><output id="light-cutoff-value">95%</output></span>
          <input id="setting-light-cutoff" type="range" min="50" max="100" value="95" />
        </label>
        <label class="range-control">
          <span><span>Default tile spacing</span><output id="default-tile-spacing-value">5%</output></span>
          <input id="setting-tile-spacing" type="range" min="0" max="50" value="5" />
        </label>
      </section>

      <section class="settings-card">
        <div class="settings-intro"><h3>Visitor controls</h3><p>These permissions apply while fair mode is enabled.</p></div>
        <div class="permission-grid">
          <label><input id="permission-subject" type="checkbox" checked /> Subject controls</label>
          <label><input id="permission-message" type="checkbox" checked /> Message editing</label>
          <label><input id="permission-size" type="checkbox" checked /> Tile size</label>
          <label><input id="permission-background" type="checkbox" checked /> Background switch</label>
          <label><input id="permission-mapping" type="checkbox" checked /> Tone mapping</label>
          <label><input id="permission-recolor" type="checkbox" checked /> Tile brush</label>
        </div>
        <label class="settings-toggle"><span><strong>Clear gallery after sharing</strong><small>Remove shared freezes from this device after the selected delay.</small></span><input id="setting-clear-gallery" type="checkbox" checked /></label>
        <label class="field-label">Gallery cleanup delay (seconds)<input id="setting-gallery-delay" class="text-input" type="number" min="0" max="30" step="1" value="0" /></label>
        <label class="field-label">Change admin PIN<input id="setting-pin" class="text-input" type="password" maxlength="16" autocomplete="new-password" placeholder="Leave blank to keep current PIN" /></label>
      </section>
    </div>
  </div>
</dialog>

<div class="gallery-overlay is-hidden" id="gallery-overlay" aria-label="Portrait gallery">
  <div class="gallery-panel" role="dialog" aria-modal="false" aria-labelledby="gallery-title">
    <div class="modal-heading">
      <div><p class="eyebrow">Saved on this device</p><h2 id="gallery-title">Portrait gallery</h2></div>
      <button class="icon-button" type="button" id="gallery-close" aria-label="Close gallery">×</button>
    </div>
    <p class="muted-copy gallery-help">Select portraits to share, or drag one onto the live screen for a full preview.</p>
    <div class="gallery-grid" id="gallery-grid"></div>
    <div class="gallery-empty" id="gallery-empty">Your captured portraits will appear here.</div>
    <div class="gallery-footer">
      <span class="muted-copy" id="gallery-selection-count">0 selected</span>
      <button class="button button-danger" id="gallery-remove" type="button" disabled>Remove all selected</button>
      <button class="button button-primary" id="gallery-share" type="button" disabled>Share selected</button>
    </div>
  </div>
</div>

<dialog class="modal" id="camera-dialog" aria-labelledby="camera-title">
  <div class="modal-card camera-card">
    <div class="modal-heading">
      <div><p class="eyebrow">On-device camera</p><h2 id="camera-title">Take a photo</h2></div>
      <button class="icon-button" type="button" data-close="camera-dialog" aria-label="Close">×</button>
    </div>
    <div class="camera-view">
      <video id="camera-video" autoplay playsinline></video>
      <p id="camera-status">Requesting camera access…</p>
    </div>
    <div class="button-row align-end">
      <button class="button button-quiet" type="button" data-close="camera-dialog">Cancel</button>
      <button class="button button-primary" type="button" id="capture-photo">Capture &amp; pixelate</button>
    </div>
  </div>
</dialog>

<dialog class="modal" id="share-dialog" aria-labelledby="share-title">
  <div class="modal-card share-card">
    <div class="modal-heading">
      <div><p class="eyebrow">Your artwork</p><h2 id="share-title">Send it to someone</h2></div>
      <button class="icon-button" type="button" data-close="share-dialog" aria-label="Close sharing options">×</button>
    </div>
    <p class="muted-copy">Share a PNG image with nearby devices or messaging apps, or save the original SVG.</p>
    <button class="button button-primary share-native-button" id="share-native" type="button">↗ &nbsp;Open share sheet</button>
    <div class="share-options">
      <button class="button button-quiet" id="share-download-png" type="button">↓ &nbsp;Save PNG image</button>
      <button class="button button-quiet" id="share-download-svg" type="button">↓ &nbsp;Save SVG artwork</button>
      <button class="button button-quiet" id="share-copy-svg" type="button">Copy SVG code</button>
    </div>
    <p class="fine-print" id="share-help">The share sheet is available on supported devices. Your artwork is prepared locally.</p>
  </div>
</dialog>

<video id="live-camera-video" class="live-camera-video" autoplay playsinline muted aria-hidden="true"></video>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<canvas id="sampling-canvas" hidden></canvas>
