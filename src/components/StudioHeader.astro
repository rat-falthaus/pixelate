---
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<header class="topbar">
  <a class="brand-lockup" href={baseUrl} aria-label="Studio home">
    <span class="brand-mark" aria-hidden="true">
      <i></i><i></i><i></i><i></i>
    </span>
    <span class="brand-copy">
      <strong id="brand-title">Pixel Studio</strong>
      <small><span class="status-dot"></span><span id="mode-label">Brand palette</span></small>
    </span>
  </a>

  <div class="topbar-actions">
    <button class="button button-quiet" id="camera-open" type="button">
      <span aria-hidden="true">◎</span><span class="optional-label">Camera</span>
    </button>
    <button class="button button-quiet" id="upload-open" type="button">
      <span aria-hidden="true">↑</span><span class="optional-label">Add photo</span>
    </button>
    <button class="button button-quiet desktop-action fair-hide" id="copy-svg" type="button">Copy SVG</button>
    <button class="button button-quiet" data-action="share" type="button" aria-label="Share your artwork">
      <span aria-hidden="true">↗</span><span class="optional-label">Share</span>
    </button>
    <button class="button button-primary" id="download-svg" type="button">
      <span aria-hidden="true">↓</span><span>Export SVG</span>
    </button>
    <button class="button button-admin" id="admin-open" type="button" aria-label="Open studio settings" title="Studio settings">
      <span aria-hidden="true">⚙</span><span class="optional-label">Settings</span>
    </button>
  </div>
</header>
