---
import '../styles/studio.css';

interface Props {
  title?: string;
}

const { title = 'Pixel studio' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111311" />
    <meta name="description" content="A private, in-browser photo-to-pixel-SVG studio." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
